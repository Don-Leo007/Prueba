{{ 'al-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'al-scripts.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .al-beneficios__head { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .al-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .al-beneficios__intro { font-size: {{ section.settings.body_size }}px; line-height: 1.6; margin-top: 14px; }
  #shopify-section-{{ section.id }} .al-beneficios__grid { grid-template-columns: repeat({{ section.settings.columnas }}, 1fr); --al-gap: {{ section.settings.separacion }}px; --al-icon: {{ section.settings.icon_size }}px; }
  #shopify-section-{{ section.id }} .al-card p { font-size: {{ section.settings.card_text_size }}px; }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .al-beneficios__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 540px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px; }
    #shopify-section-{{ section.id }} .al-beneficios__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .al-h2 { font-size: {{ section.settings.heading_size | times: 0.75 | round }}px; }
  }
{% endstyle %}

<section class="al-beneficios al-section">
  <div class="al-container">
    <div class="al-beneficios__head al-reveal{% if section.settings.text_align == 'center' %} al-text-center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="al-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="al-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.intro != blank -%}<p class="al-beneficios__intro al-muted">{{ section.settings.intro | newline_to_br }}</p>{%- endif -%}
    </div>
    <div class="al-beneficios__grid">
      {%- for block in section.blocks -%}
        <article class="al-card al-reveal" style="--al-i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <div class="al-card__icon" aria-hidden="true">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {{ block.settings.emoji }}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.titulo }}</h3>
          <p>{{ block.settings.texto | newline_to_br }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Alivia – Beneficios",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño sobre el título", "default": "Por qué te va a encantar" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Un spa en tus hombros, en solo 15 minutos" },
    { "type": "textarea", "id": "intro", "label": "Texto", "default": "Diseñado para adaptarse a tu cuello, hombros, espalda, cintura y piernas." },
    { "type": "header", "content": "Diseño" },
    { "type": "range", "id": "columnas", "label": "Columnas en computadora", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "separacion", "label": "Separación entre tarjetas (px)", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "icon_size", "label": "Tamaño de los iconos (px)", "min": 36, "max": 90, "step": 2, "unit": "px", "default": 56 },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "text_align", "label": "Alineación del título", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 22, "max": 72, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_text_size", "label": "Tamaño del texto de las tarjetas (px)", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#FFFBF6" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Icono (emoji)", "default": "✨" },
        { "type": "image_picker", "id": "imagen", "label": "O una imagen como icono" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Beneficio" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Explica aquí el beneficio." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alivia – Beneficios",
      "blocks": [
        { "type": "beneficio" },
        { "type": "beneficio" },
        { "type": "beneficio" }
      ]
    }
  ]
}
{% endschema %}
