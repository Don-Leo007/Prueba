{{ 'al-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'al-scripts.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_pagina }};
  }
  #shopify-section-{{ section.id }} .al-cta__box {
    background: radial-gradient(circle at 20% 0%, {{ section.settings.color_fondo_2 }} 0%, {{ section.settings.color_fondo }} 60%);
    color: {{ section.settings.color_texto }};
    text-align: {{ section.settings.text_align }};
  }
  #shopify-section-{{ section.id }} .al-h2 { font-size: {{ section.settings.heading_size }}px; max-width: 18em; margin: 0 auto; }
  #shopify-section-{{ section.id }} .al-cta__texto { font-size: {{ section.settings.body_size }}px; line-height: 1.6; margin: 16px auto 0; max-width: 36em; opacity: 0.88; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px; }
    #shopify-section-{{ section.id }} .al-h2 { font-size: {{ section.settings.heading_size | times: 0.75 | round }}px; }
  }
{% endstyle %}

<section class="al-cta al-section">
  <div class="al-container">
    <div class="al-cta__box al-reveal">
      <h2 class="al-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="al-cta__texto">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
      {%- if section.settings.boton_texto != blank -%}
        <a class="al-btn" href="{{ section.settings.boton_link | default: '#comprar' }}">{{ section.settings.boton_texto }}</a>
      {%- endif -%}
      <ul class="al-chips">
        {%- if section.settings.chip_1 != blank -%}<li class="al-chip">{% render 'al-icon', nombre: 'efectivo' %}{{ section.settings.chip_1 }}</li>{%- endif -%}
        {%- if section.settings.chip_2 != blank -%}<li class="al-chip">{% render 'al-icon', nombre: 'envio' %}{{ section.settings.chip_2 }}</li>{%- endif -%}
        {%- if section.settings.chip_3 != blank -%}<li class="al-chip">{% render 'al-icon', nombre: 'garantia' %}{{ section.settings.chip_3 }}</li>{%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Alivia – Llamada final",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Regálate 15 minutos de calma cada día" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Pídelo hoy, págalo cuando llegue a tu puerta." },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Pedir el mío ahora" },
    { "type": "url", "id": "boton_link", "label": "Enlace del botón", "info": "Vacío = baja al formulario de compra (#comprar)." },
    { "type": "text", "id": "chip_1", "label": "Garantía 1", "default": "Pago contra entrega" },
    { "type": "text", "id": "chip_2", "label": "Garantía 2", "default": "Envío gratis" },
    { "type": "text", "id": "chip_3", "label": "Garantía 3", "default": "30 días de garantía" },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 22, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_pagina", "label": "Fondo de la página", "default": "#FFFBF6" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la caja", "default": "#12302F" },
    { "type": "color", "id": "color_fondo_2", "label": "Brillo de la caja", "default": "#2F7A74" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#FFFBF6" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Alivia – Llamada final" } ]
}
{% endschema %}
